{
  "name": "trazal-backend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev --local",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "build": "node scripts/wrangler.mjs deploy --dry-run --outdir dist",
    "test:desktop": "node --import tsx scripts/test-desktop.ts",
    "migrate": "node --import tsx scripts/migrate.ts",
    "deploy": "node scripts/wrangler.mjs deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "jose": "6.2.17",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trazal-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "send_metrics": false,
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false }
}

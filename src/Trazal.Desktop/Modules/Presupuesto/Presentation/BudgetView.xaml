<UserControl x:Class="Trazal.Desktop.Modules.Presupuesto.Presentation.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Trazal.Desktop">
  <Grid Margin="32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <DockPanel Margin="0,0,0,20">
      <Button DockPanel.Dock="Right"
              Content="＋  Agregar concepto"
              Style="{StaticResource Primary}"
              Command="{Binding Add}"
              VerticalAlignment="Center" />
      <StackPanel>
        <TextBlock Text="Presupuesto" Style="{StaticResource Heading}" Margin="0,0,0,4" />
        <TextBlock Text="Catálogo de conceptos con precio unitario deducido e importe original."
                   Foreground="{DynamicResource Muted}" />
      </StackPanel>
    </DockPanel>

    <!-- Tarjeta de totales -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right"
                   Text="{Binding Count}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Muted}" />
        <StackPanel>
          <TextBlock Text="Importes del catálogo"
                     Foreground="{DynamicResource Muted}"
                     FontSize="14" />
          <TextBlock Text="{Binding TotalImporte}"
                     FontSize="28"
                     FontWeight="SemiBold"
                     Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Filtros de búsqueda -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
      <vm:ResponsivePanel ColumnsLimit="2" MinimumItemWidth="260" Gap="14">
        <StackPanel>
          <TextBlock Text="Buscar concepto o clave" FontSize="14" Margin="0,0,0,8" />
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                   AutomationProperties.Name="Buscar concepto o clave" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Filtrar por obra" FontSize="14" Margin="0,0,0,8" />
          <ComboBox ItemsSource="{Binding WorkTitles}"
                    SelectedItem="{Binding WorkFilter}"
                    AutomationProperties.Name="Filtrar por obra" />
        </StackPanel>
      </vm:ResponsivePanel>
    </Border>

    <!-- Tabla de conceptos -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
      <Grid>
        <DataGrid ItemsSource="{Binding Items}"
                  AutomationProperties.Name="Presupuesto — conceptos"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Clave / partida"
                                Binding="{Binding Code}"
                                Width="130" MinWidth="130" />
            <DataGridTextColumn Header="Concepto"
                                Binding="{Binding Description}"
                                Width="*" MinWidth="200" />
            <DataGridTextColumn Header="Cantidad"
                                Binding="{Binding Quantity}"
                                Width="110" MinWidth="110" />
            <DataGridTextColumn Header="Unidad"
                                Binding="{Binding Unit}"
                                Width="90" MinWidth="90" />
            <DataGridTextColumn Header="P.U. deducido"
                                Binding="{Binding UnitPrice}"
                                Width="145" MinWidth="145" />
            <DataGridTextColumn Header="Importe original"
                                Binding="{Binding Amount}"
                                Width="145" MinWidth="145" />
            <DataGridTemplateColumn Width="90" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Editar"
                          Style="{StaticResource Quiet}"
                          Padding="8,4"
                          MinHeight="34"
                          Command="{Binding Edit}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Estado vacío -->
        <StackPanel Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="30,60,30,20"
                    MaxWidth="460">
          <TextBlock Text="Sin conceptos en el presupuesto."
                     FontSize="22"
                     FontWeight="SemiBold"
                     TextAlignment="Center" />
          <TextBlock Text="Agrega excavación, concreto u otros conceptos con su precio unitario deducido e importe."
                     Foreground="{DynamicResource Muted}"
                     TextAlignment="Center"
                     Margin="0,12,0,24" />
          <Button Content="＋  Agregar primer concepto"
                  Style="{StaticResource Primary}"
                  Command="{Binding Add}"
                  HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pie con total -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Background="{DynamicResource AccentSoft}"
            Padding="20" Margin="0,16,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right"
                   Text="{Binding TotalImporte}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Text="Total del catálogo (sin IVA)" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="Trazal.Desktop.Modules.Programa.Presentation.ProgramaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Trazal.Desktop"
             xmlns:local="clr-namespace:Trazal.Desktop.Modules.Programa.Presentation">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- encabezado -->
      <RowDefinition Height="Auto"/>  <!-- filtros     -->
      <RowDefinition Height="*"/>     <!-- tabla       -->
    </Grid.RowDefinitions>

    <!-- ── Encabezado ──────────────────────────────────────────── -->
    <DockPanel Margin="32,24,32,0">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Programa de obra" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
        <TextBlock Text="Distribución mensual de cada concepto según el plan de días programados."
                   Foreground="{DynamicResource Muted}"/>
      </StackPanel>
    </DockPanel>

    <!-- ── Filtros ─────────────────────────────────────────────── -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,16,32,0" Padding="16">
      <DockPanel>
        <!-- búsqueda -->
        <StackPanel DockPanel.Dock="Left" Width="280" Margin="0,0,16,0">
          <TextBlock Text="Buscar concepto o clave" FontSize="13" Margin="0,0,0,6"/>
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                   AutomationProperties.Name="Buscar concepto o clave"/>
        </StackPanel>
        <!-- obra -->
        <StackPanel DockPanel.Dock="Left" Width="240" Margin="0,0,16,0">
          <TextBlock Text="Filtrar por obra" FontSize="13" Margin="0,0,0,6"/>
          <ComboBox ItemsSource="{Binding WorkTitles}"
                    SelectedItem="{Binding WorkFilter}"
                    AutomationProperties.Name="Filtrar por obra"/>
        </StackPanel>
        <!-- contador -->
        <TextBlock Text="{Binding Count}"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource Muted}"
                   HorizontalAlignment="Right"
                   Margin="0,0,0,4"/>
      </DockPanel>
    </Border>

    <!-- ── Tabla del programa ──────────────────────────────────── -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="32,12,32,24" Padding="0" ClipToBounds="True">
      <Grid>

        <!-- tabla con datos — visible cuando hay filas (ocultar via DataTrigger en style) -->
        <DataGrid x:Name="ConceptGrid"
                  ItemsSource="{Binding Items}"
                  AutomationProperties.Name="Programa de obra — conceptos"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Style>
            <Style TargetType="DataGrid">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Empty}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.Style>
          <DataGrid.Columns>

            <!-- Concepto + unidad -->
            <DataGridTemplateColumn Header="Concepto" Width="260" MinWidth="200" CanUserSort="True" SortMemberPath="Description">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,6">
                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Unit}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Inicio / Término -->
            <DataGridTextColumn Header="Inicio / término"
                                Binding="{Binding Period}"
                                Width="170" MinWidth="150"
                                CanUserSort="True" SortMemberPath="StartDate"/>

            <!-- Columnas de meses — se inyectan desde ProgramaView.xaml.cs -->

            <!-- Reprogramar -->
            <DataGridTemplateColumn Width="120" MinWidth="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Reprogramar"
                          Style="{StaticResource Quiet}"
                          Padding="8,4"
                          MinHeight="34"
                          Command="{Binding Reschedule}"
                          ToolTip="Abre la obra para editar el programa"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

          </DataGrid.Columns>
        </DataGrid>

        <!-- estado vacío — solo cuando Empty=True -->
        <StackPanel Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="30,60,30,24" MaxWidth="460">
          <TextBlock Text="Sin conceptos programados."
                     FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock Text="Agrega conceptos desde el módulo de Presupuesto y distribúyelos en el programa de cada obra."
                     Foreground="{DynamicResource Muted}"
                     TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

      </Grid>
    </Border>
  </Grid>
</UserControl>

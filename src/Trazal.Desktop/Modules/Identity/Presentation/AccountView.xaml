<UserControl x:Class="Trazal.Desktop.Modules.Identity.Presentation.AccountView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="PasswordBox">
   <Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="12,12"/><Setter Property="MinHeight" Value="48"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#A68E22"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,24">
   <Button Content="← Volver a mis obras" Command="{Binding Back}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="-10,0,0,12"/>
   <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}"/>
   <TextBlock Text="Tu cuenta para conectar tus equipos. Tus obras siguen disponibles sin internet." Foreground="{DynamicResource Muted}" Margin="0,4,0,22"/>
   <Border Style="{StaticResource Card}" Background="{DynamicResource Tint}" Padding="18" Margin="0,0,0,18" Visibility="{Binding PendingConfiguration,Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="{Binding ConfigurationMessage}"/>
   </Border>
   <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch" MaxWidth="960">
    <StackPanel>
     <StackPanel Visibility="{Binding SignedOut,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEdit}">
      <WrapPanel Margin="-8,0,0,20">
       <Button Content="Iniciar sesión" Command="{Binding LoginMode}" Style="{StaticResource Quiet}"/>
       <Button Content="Crear cuenta" Command="{Binding RegisterMode}" Style="{StaticResource Quiet}"/>
       <Button Content="Olvidé mi contraseña" Command="{Binding ResetMode}" Style="{StaticResource Quiet}"/>
      </WrapPanel>
      <TextBlock Text="* Campos obligatorios" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,18"/>
      <TextBlock Text="Correo electrónico *" Margin="0,0,0,8"/>
      <Grid Margin="0,0,0,20">
       <TextBox Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Correo electrónico obligatorio"/>
       <TextBlock Text="nombre@empresa.com" Foreground="{DynamicResource Muted}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Email}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <StackPanel Visibility="{Binding HasPassword,Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="Contraseña *" Margin="0,0,0,8"/>
       <Grid Margin="0,0,0,18"><PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged" MaxLength="4096" AutomationProperties.Name="Contraseña obligatoria"/><TextBlock x:Name="PasswordHint" Text="Escribe tu contraseña" Foreground="{DynamicResource Muted}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
       <StackPanel Visibility="{Binding IsRegistration,Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="Mínimo 8 caracteres. Se aplica también la política del proyecto." FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,-8,0,18"/>
        <TextBlock Text="Confirmar contraseña *" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,18"><PasswordBox x:Name="ConfirmationInput" PasswordChanged="ConfirmationChanged" MaxLength="4096" AutomationProperties.Name="Confirmar contraseña obligatoria"/><TextBlock x:Name="ConfirmationHint" Text="Vuelve a escribir la contraseña" Foreground="{DynamicResource Muted}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
       </StackPanel>
       <CheckBox Content="Recordar mi sesión en este usuario de Windows" IsChecked="{Binding Remember}" Margin="0,2,0,20"/>
      </StackPanel>
      <Button Content="{Binding SubmitLabel}" Command="{Binding Submit}" Style="{StaticResource Primary}" HorizontalAlignment="Right" MinWidth="180"/>
     </StackPanel>
     <StackPanel Visibility="{Binding SignedIn,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding AccountEmail}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding SessionStatus}" Foreground="{DynamicResource Muted}" Margin="0,12,0,24"/>
      <TextBlock Text="Este espacio pertenece a tu cuenta. Al cerrar sesión volverás al espacio local original; las obras de ambos espacios se conservan por separado." Margin="0,0,0,24"/>
      <WrapPanel><Button Content="Enviar verificación" Command="{Binding Verify}" Margin="0,0,12,12"/><Button Content="Ya confirmé mi correo / comprobar sesión" Command="{Binding RefreshIdentity}" Style="{StaticResource Primary}" Margin="0,0,12,12"/><Button Content="Cerrar sesión" Command="{Binding SignOut}" Margin="0,0,0,12"/></WrapPanel>
     </StackPanel>
     <TextBlock Text="{Binding Message}" Margin="0,20,0,0" Foreground="{DynamicResource Ink}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>

<Window x:Class="Trazal.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Trazal.Desktop" Title="Trazal · Control de obra · Vista previa" Style="{StaticResource {x:Type Window}}" Width="1280" Height="820" MinWidth="780" MinHeight="580" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <DataTemplate xmlns:account="clr-namespace:Trazal.Desktop.Modules.Identity.Presentation" DataType="{x:Type account:AccountViewModel}"><account:AccountView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SyncViewModel}">
      <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Sincronización" Style="{StaticResource Heading}"/><Button Style="{StaticResource Help}" Click="Help_Click" AutomationProperties.Name="Ayuda de sincronización"><Button.ToolTip><TextBlock Text="Comprobar conexión valida tu cuenta y el acceso a la base de datos, sin transferir obras. Sincronizar envía las obras del espacio activo y descarga sus cambios remotos. Si hay cambios en ambos equipos, se conserva cada copia y se marca el conflicto. Una copia en la nube puede no incluir tus últimas ediciones locales."/></Button.ToolTip></Button></StackPanel>
          <TextBlock Text="Trabaja sin conexión. Conserva el control de tus obras." Foreground="{DynamicResource Muted}" Margin="0,10,0,20"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="{Binding Connection}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Guidance}" Foreground="{DynamicResource Muted}" Margin="0,8,0,16" TextWrapping="Wrap"/>
            <WrapPanel>
              <Button Content="Ir a Mi cuenta" Command="{Binding Account}" Visibility="{Binding NeedsAccount,Converter={StaticResource BoolVisibility}}" Margin="0,0,12,8"/>
              <Button Content="Comprobar conexión" Command="{Binding CheckConnection}" Margin="0,0,12,8"/>
              <Button Content="Sincronizar mis obras" Style="{StaticResource Primary}" Command="{Binding Run}" Margin="0,0,0,8"/>
            </WrapPanel>
            <Border Background="{DynamicResource Tint}" CornerRadius="8" Padding="14" Margin="0,10,0,0" Visibility="{Binding HasResult,Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="{Binding Result}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
          <Grid>
          <TextBlock Text="Todavía no hay obras en este espacio. Puedes crear una o sincronizar para descargar las de tu cuenta." Margin="22" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"/>
          <DataGrid ItemsSource="{Binding Rows}" AutomationProperties.Name="Estado de sincronización de las obras">
            <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
            <DataGrid.Columns><DataGridTextColumn Header="Obra" Binding="{Binding Title}" Width="*" MinWidth="200"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="250"/><DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*" MinWidth="180"/></DataGrid.Columns>
          </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,24">
          <Button Content="← Volver al presupuesto" Command="{Binding Back}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="-10,0,0,8"/>
          <TextBlock Text="{Binding Work.Title}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
            <TextBlock Text="Curva S y desempeño" Style="{StaticResource Heading}"/>
            <Button Style="{StaticResource Help}" Click="Help_Click" AutomationProperties.Name="Cómo leer la Curva S">
              <Button.ToolTip><TextBlock Text="Compara acumulados sin IVA. Azul: programa original. Gris: último avance de cada concepto, valorado al precio del presupuesto. Rojo: gastos registrados. Las líneas escalonadas conservan los cortes medidos; no inventan avance entre fechas. La línea vertical marca el corte. El programa futuro sigue visible."/></Button.ToolTip>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding Baseline}" Foreground="{DynamicResource Muted}"/>
          <WrapPanel Margin="0,18,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,8"><TextBlock Text="Corte" VerticalAlignment="Center" Margin="0,0,10,0"/><DatePicker SelectedDate="{Binding Cut}" Width="200" AutomationProperties.Name="Fecha de corte de Curva S"/></StackPanel>
            <Button Content="Exportar PDF" Command="{Binding Pdf}" Style="{StaticResource Primary}" Margin="0,0,10,8"/>
            <Button Content="Exportar Excel" Command="{Binding Excel}" Margin="0,0,0,8"/>
          </WrapPanel>
          <vm:ResponsivePanel ColumnsLimit="3" MinimumItemWidth="210" Gap="14">
            <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Programa · PV" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Planned}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/><Border Background="#4197C9" Height="3" Margin="0,14,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Ejecutado · EV" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Earned}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/><Border Background="#8C9399" Height="3" Margin="0,14,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Gastos · AC" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Spent}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/><Border Background="#DE6354" Height="3" Margin="0,14,0,0"/></StackPanel></Border>
          </vm:ResponsivePanel>
          <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,16">
            <StackPanel>
              <TextBlock Text="{Binding Reading}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <vm:CurveChart Snapshot="{Binding Snapshot}" Ink="{DynamicResource Muted}" Height="300" AutomationProperties.Name="Curva acumulada de programa, ejecutado y gastos. Los valores están disponibles en el detalle por fecha."/>
              <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="━ Programa fijo" Foreground="#4197C9" Margin="0,0,24,4"/>
                <TextBlock Text="┄ Ejecutado" Foreground="{DynamicResource Muted}" Margin="0,0,24,4"/>
                <TextBlock Text="┈ Gastos" Foreground="#DE6354" Margin="0,0,0,4"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <vm:ResponsivePanel ColumnsLimit="2" MinimumItemWidth="260" Gap="14">
            <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
              <StackPanel Orientation="Horizontal"><TextBlock Text="Ritmo de avance · SPI" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource Help}" Click="Help_Click" AutomationProperties.Name="Ayuda SPI"><Button.ToolTip><TextBlock Text="Ejecutado / programado. Mayor que 1: adelantado; menor que 1: atrasado; 1: conforme al programa. No disponible cuando el programa acumulado es cero. Requiere línea base fijada."/></Button.ToolTip></Button></StackPanel>
              <TextBlock Text="{Binding Spi}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="{Binding Percent}" Foreground="{DynamicResource Muted}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
              <StackPanel Orientation="Horizontal"><TextBlock Text="Relación avance / gasto · CPI" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource Help}" Click="Help_Click" AutomationProperties.Name="Ayuda CPI"><Button.ToolTip><TextBlock Text="Ejecutado / gastos. Menor que 1: gastaste más que el valor ejecutado. Es orientativo: el presupuesto puede incluir utilidad y las compras pueden ser anticipadas. No equivale a utilidad contable ni inventario consumido. Sin gastos registrados no se puede calcular. Usa todos los gastos de la obra sin IVA."/></Button.ToolTip></Button></StackPanel>
              <TextBlock Text="{Binding Cpi}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Según los gastos registrados al corte" Foreground="{DynamicResource Muted}"/>
            </StackPanel></Border>
          </vm:ResponsivePanel>
          <WrapPanel Margin="0,18,0,12"><Button Content="Ver programa" Command="{Binding Program}" Margin="0,0,10,8"/><Button Content="Registrar avance" Command="{Binding Progress}" Margin="0,0,10,8"/><Button Content="Revisar gastos" Command="{Binding Expenses}" Margin="0,0,0,8"/></WrapPanel>
          <Expander Header="Detalle por fecha" Foreground="{DynamicResource Ink}">
            <DataGrid ItemsSource="{Binding Snapshot.Points}" MaxHeight="370" Margin="0,12,0,0" AutomationProperties.Name="Detalle accesible de la Curva S">
              <DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date,StringFormat=dd/MM/yyyy}" Width="140"/><DataGridTextColumn Header="Programa" Binding="{Binding Planned,StringFormat={}{0:C2}}" Width="*" MinWidth="160"/><DataGridTextColumn Header="Ejecutado" Binding="{Binding Earned,StringFormat={}{0:C2}}" Width="*" MinWidth="160"/><DataGridTextColumn Header="Gastos" Binding="{Binding Spent,StringFormat={}{0:C2}}" Width="*" MinWidth="160"/></DataGrid.Columns>
            </DataGrid>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <Style x:Key="NavigationItem" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type vm:Field}">
      <StackPanel Margin="0,0,0,19">
        <TextBlock Text="{Binding Label}" Margin="0,0,0,8" />
        <Grid>
          <TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}" AutomationProperties.Name="{Binding Label}">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChoice}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsDate}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsChoice,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Label}" />
          <DatePicker SelectedDate="{Binding DateValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Visibility="{Binding IsDate,Converter={StaticResource BoolVisibility}}" MinHeight="46" FontSize="16" Foreground="{DynamicResource Ink}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" AutomationProperties.Name="{Binding Label}" ToolTip="Selecciona la fecha con el botón del calendario.">
            <DatePicker.Resources>
              <Style TargetType="DatePickerTextBox"><Setter Property="IsReadOnly" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
            </DatePicker.Resources>
          </DatePicker>
          <TextBlock Text="{Binding Placeholder}" Foreground="{DynamicResource Muted}" Margin="13,0,38,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Focusable="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Value}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsDate}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <TextBlock Text="{Binding Help}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,5,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Help}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ImportViewModel}">
      <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Content="Volver al presupuesto" Command="{Binding Back}" VerticalAlignment="Top"/>
          <StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Muted}"/><WrapPanel><TextBlock Text="Importar catálogo" Style="{StaticResource Heading}"/><Button Style="{StaticResource Help}" Click="Help_Click" AutomationProperties.Name="Ayuda para importar" ToolTip="Elige hoja, filas y columnas; prepara la vista previa y revisa el subtotal. Se leen valores guardados en Excel, no se recalculan fórmulas. Guarda y recalcula el libro en Excel antes de importarlo. Los conceptos existentes no se reemplazan. Si el precio está en la fila siguiente, activa esa opción y selecciona su columna."/></WrapPanel></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14" IsEnabled="{Binding Ready}">
          <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <WrapPanel Margin="0,0,0,12"><Button Content="Elegir Excel" Command="{Binding Choose}"/><TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="14,0" MaxWidth="420" TextTrimming="CharacterEllipsis"/></WrapPanel>
              <WrapPanel>
                <StackPanel Width="250" Margin="0,0,16,12"><TextBlock Text="Hoja *" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding Sheet}" AutomationProperties.Name="Hoja de Excel"/></StackPanel>
                <StackPanel Width="120" Margin="0,0,16,12"><TextBlock Text="Encabezado *" Margin="0,0,0,6"/><TextBox Text="{Binding Header,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Fila del encabezado"/></StackPanel>
                <StackPanel Width="120" Margin="0,0,16,12"><TextBlock Text="Primera fila *" Margin="0,0,0,6"/><TextBox Text="{Binding First,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Primera fila de datos"/></StackPanel>
                <StackPanel Width="120" Margin="0,0,0,12"><TextBlock Text="Última fila *" Margin="0,0,0,6"/><TextBox Text="{Binding Last,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Última fila de datos"/></StackPanel>
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding Columns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="210" Margin="0,0,14,12"><TextBlock Text="{Binding Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding Index}" AutomationProperties.Name="{Binding Label}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <WrapPanel><CheckBox IsChecked="{Binding PriceNextRow}" Content="Precio en la fila siguiente" VerticalAlignment="Center" Margin="0,0,20,8"/><Button Content="Preparar vista previa" Command="{Binding Preview}" Margin="0,0,0,8"/></WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
          <DataGrid ItemsSource="{Binding Rows}" AutomationProperties.Name="Vista previa del catálogo" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
            <DataGridTemplateColumn Header="Incluir" Width="75" MinWidth="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Include,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Incluir fila"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="Fila" Binding="{Binding Row}" Width="65" MinWidth="65"/>
            <DataGridTextColumn Header="Clave" Binding="{Binding Code}" Width="115" MinWidth="115"/>
            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" MinWidth="240"/>
            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="90" MinWidth="90"/>
            <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="120" MinWidth="120"/>
            <DataGridTextColumn Header="P. unitario" Binding="{Binding Price}" Width="120" MinWidth="120"/>
            <DataGridTextColumn Header="Revisión" Binding="{Binding Error}" Width="320" MinWidth="320"/>
          </DataGrid.Columns></DataGrid>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}"/>
          <TextBlock Text="{Binding Summary}" Margin="0,4,0,10"/>
          <WrapPanel><CheckBox IsChecked="{Binding Reviewed}" VerticalAlignment="Center" Margin="0,0,20,10"><TextBlock Text="Revisé las filas seleccionadas, precios y subtotal." MaxWidth="380"/></CheckBox><Button Content="Importar selección" Command="{Binding Import}" Style="{StaticResource Primary}" Margin="0,0,0,10"/></WrapPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProgramViewModel}">
      <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Presupuesto" Command="{Binding Back}" VerticalAlignment="Top"/><StackPanel><TextBlock Text="{Binding Work.Title}" Foreground="{DynamicResource Muted}"/><WrapPanel><TextBlock Text="{Binding Title}" Style="{StaticResource Heading}"/><Button Style="{StaticResource Help}" Click="Help_Click" ToolTip="Distribuye cantidades diarias por concepto y fija el programa cuando esté completo. Una vez fijado, el presupuesto y la distribución se conservan. Los avances son acumulados por fecha; no se suman entre cortes. Selecciona una fila para ver los días o el historial. Las penalizaciones se gestionan fuera de Trazal."/></WrapPanel></StackPanel></DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
          <Button Content="{Binding SwitchLabel}" Command="{Binding Switch}" Margin="0,0,12,8"/>
          <Button Content="Distribuir fechas" Command="{Binding Distribute}" Visibility="{Binding Editable,Converter={StaticResource BoolVisibility}}" Margin="0,0,12,8"/>
          <Button Content="Agregar día" Command="{Binding Day}" Visibility="{Binding Editable,Converter={StaticResource BoolVisibility}}" Margin="0,0,12,8"/>
          <Button Content="Fijar programa" Command="{Binding Freeze}" Visibility="{Binding Editable,Converter={StaticResource BoolVisibility}}" Style="{StaticResource Primary}" Margin="0,0,12,8"/>
          <Button Content="Registrar avance" Command="{Binding Record}" Visibility="{Binding IsProgress,Converter={StaticResource BoolVisibility}}" Style="{StaticResource Primary}" Margin="0,0,12,8"/>
        </WrapPanel>
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
          <TextBlock Text="Fecha de corte" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker SelectedDate="{Binding Cut}" Width="160" Margin="0,0,18,0" AutomationProperties.Name="Fecha de corte"/>
          <TextBlock Text="{Binding State}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
        </WrapPanel>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><Grid>
          <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Visibility="{Binding IsPlan,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Programa por concepto" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
            <DataGridTextColumn Header="Clave" Binding="{Binding Code}" Width="100" MinWidth="100"/>
            <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*" MinWidth="230"/>
            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="80" MinWidth="80"/>
            <DataGridTextColumn Header="Contratado" Binding="{Binding Quantity,StringFormat={}{0:0.####}}" Width="125" MinWidth="125"/>
            <DataGridTextColumn Header="Distribuido" Binding="{Binding Scheduled,StringFormat={}{0:0.####}}" Width="125" MinWidth="125"/>
            <DataGridTextColumn Header="Distribución" Binding="{Binding Coverage}" Width="195" MinWidth="195"/>
          </DataGrid.Columns></DataGrid>
          <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Visibility="{Binding IsProgress,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Avance por concepto" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
            <DataGridTextColumn Header="Clave" Binding="{Binding Code}" Width="100" MinWidth="100"/>
            <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*" MinWidth="230"/>
            <DataGridTextColumn Header="Plan (%)" Binding="{Binding PlannedPercent,StringFormat={}{0:0.##}}" Width="105" MinWidth="105"/>
            <DataGridTextColumn Header="Real (%)" Binding="{Binding Percent,StringFormat={}{0:0.##}}" Width="105" MinWidth="105"/>
            <DataGridTextColumn Header="Acumulado" Binding="{Binding Actual,StringFormat={}{0:0.####}}" Width="130" MinWidth="130"/>
            <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="80" MinWidth="80"/>
            <DataGridTextColumn Header="Al corte" Binding="{Binding State}" Width="205" MinWidth="205"/>
          </DataGrid.Columns></DataGrid>
        </Grid></Border>
        <TextBlock Grid.Row="4" Text="{Binding Detail}" FontWeight="SemiBold" Margin="0,14,0,10"/>
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <DataGrid ItemsSource="{Binding Days}" Visibility="{Binding IsPlan,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Distribución diaria"><DataGrid.Columns>
              <DataGridTextColumn Header="Fecha programada" Binding="{Binding Date,StringFormat={}{0:dd/MM/yyyy}}" Width="200"/>
              <DataGridTextColumn Header="Cantidad del día" Binding="{Binding Quantity,StringFormat={}{0:0.####}}" Width="*"/>
              <DataGridTemplateColumn Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Ajustar" Command="{Binding DataContext.EditDay,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource Quiet}" Padding="6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid>
            <DataGrid ItemsSource="{Binding History}" Visibility="{Binding IsProgress,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Historial de avances"><DataGrid.Columns>
              <DataGridTextColumn Header="Fecha de medición" Binding="{Binding Date,StringFormat={}{0:dd/MM/yyyy}}" Width="180"/>
              <DataGridTextColumn Header="Cantidad acumulada" Binding="{Binding Quantity,StringFormat={}{0:0.##########}}" Width="210"/>
              <DataGridTextColumn Header="Observación" Binding="{Binding Note}" Width="*" MinWidth="240"/>
            </DataGrid.Columns></DataGrid>
          </Grid>
        </Border>
        <StackPanel Grid.Row="6" Margin="0,12,0,0"><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Totals}" Margin="0,6,0,0"/></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,24">
          <DockPanel Margin="0,0,0,26">
            <Button DockPanel.Dock="Right" Content="＋  Crear obra" Style="{StaticResource Primary}" Command="{Binding Create}" VerticalAlignment="Center" Margin="24,0,0,0" />
            <StackPanel>
              <TextBlock Text="TU ESPACIO DE TRABAJO" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,9" />
              <TextBlock Text="Cada obra, bajo control." Style="{StaticResource Heading}" />
              <TextBlock Text="Tus proyectos y sus presupuestos, en un solo lugar." Style="{StaticResource MutedText}" />
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,26">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,22,0">
                <TextBlock Text="Buscar obra" FontSize="14" Margin="0,0,0,8" />
                <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=180}" AutomationProperties.Name="Buscar obra" ToolTip="Busca por nombre, tipo o alcance." />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Tipo de obra" FontSize="14" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" AutomationProperties.Name="Filtrar tipo de obra" />
              </StackPanel>
            </Grid>
          </Border>
          <DockPanel Margin="0,0,0,18">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
            <TextBlock Text="Mis obras" Style="{StaticResource SectionTitle}" />
          </DockPanel>
          <Border Style="{StaticResource Card}" Visibility="{Binding Empty,Converter={StaticResource BoolVisibility}}" Padding="32,46">
            <StackPanel HorizontalAlignment="Center" MaxWidth="520">
              <Border Background="{DynamicResource AccentSoft}" Width="66" Height="66" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Path Data="M3,8 L13,8 L18,13 L35,13 L35,33 L3,33 Z M3,16 L35,16" Stroke="{DynamicResource Ink}" StrokeThickness="2" Width="36" Height="34" Stretch="Uniform" />
              </Border>
              <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" TextAlignment="Center" />
              <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,22" />
              <Button Content="Crear obra" Style="{StaticResource Primary}" Command="{Binding Create}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <vm:ResponsivePanel ColumnsLimit="2" Gap="22" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding Open}" Margin="0" Padding="24" HorizontalContentAlignment="Stretch">
                  <StackPanel>
                    <TextBlock Text="{Binding Type}" Foreground="{DynamicResource Muted}" FontSize="14" />
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,24,0,8" MaxHeight="68" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Scope}" Foreground="{DynamicResource Muted}" Height="44" TextTrimming="CharacterEllipsis" />
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,20,0,0">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="↗" FontSize="24" />
                        <StackPanel>
                          <TextBlock Text="{Binding Amount}" FontSize="23" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Count}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Los importes de las obras se muestran sin IVA." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
      <Grid Margin="32,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Volver al presupuesto" Command="{Binding Budget}"/><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Muted}"/><TextBlock Text="Gastos de la obra" Style="{StaticResource Heading}"/></StackPanel></DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="＋ Registrar gasto" Command="{Binding Add}" Style="{StaticResource Primary}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="340" HorizontalAlignment="Left" AutomationProperties.Name="Filtrar gastos por categoría"/></DockPanel>
        <ScrollViewer Grid.Row="2" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"><ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14" Margin="0,0,12,8"><StackPanel><TextBlock Text="{Binding Category}" FontSize="14"/><TextBlock Text="{Binding Subtotal}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid ItemsSource="{Binding Items}" AutomationProperties.Name="Gastos de la obra"><DataGrid.Columns>
          <DataGridTextColumn Header="Fecha" Binding="{Binding Date,StringFormat={}{0:dd/MM/yyyy}}" Width="115"/>
          <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="180"/>
          <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" MinWidth="220"/>
          <DataGridTextColumn Header="Sin IVA" Binding="{Binding Amount,StringFormat={}{0:C2}}" Width="120"/>
          <DataGridTextColumn Header="IVA" Binding="{Binding Tax,StringFormat={}{0:C2}}" Width="105"/>
          <DataGridTextColumn Header="Total" Binding="{Binding Total,StringFormat={}{0:C2}}" Width="120"/>
          <DataGridTemplateColumn Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Editar" Style="{StaticResource Quiet}" Padding="6" Command="{Binding DataContext.Edit,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns></DataGrid><TextBlock Text="No hay gastos en esta categoría. Registra el primero." Visibility="{Binding Empty,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource Muted}"/></Grid></Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18"><UniformGrid Columns="3"><StackPanel><TextBlock Text="Filtrado · sin IVA"/><TextBlock Text="{Binding Subtotal}" FontSize="24"/></StackPanel><StackPanel><TextBlock Text="IVA registrado"/><TextBlock Text="{Binding Tax}" FontSize="24"/></StackPanel><StackPanel><TextBlock Text="Total filtrado"/><TextBlock Text="{Binding Total}" FontSize="24" FontWeight="SemiBold"/></StackPanel></UniformGrid></Border>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WorkViewModel}">
      <Grid Margin="32,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,22">
          <Button DockPanel.Dock="Right" Content="Editar obra" Command="{Binding Edit}" VerticalAlignment="Center" Margin="20,0,0,0" />
          <Button DockPanel.Dock="Right" Content="Gastos de la obra" Command="{Binding Expenses}" VerticalAlignment="Center" Margin="20,0,0,0" />
          <StackPanel>
            <TextBlock Text="{Binding Type}" Foreground="{DynamicResource Muted}" FontSize="13" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0,8,0,8" TextTrimming="CharacterEllipsis" MaxHeight="92" />
            <TextBlock Text="{Binding Scope}" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
          <WrapPanel Margin="0,0,0,12">
            <Button Content="＋ Agregar concepto" Style="{StaticResource Primary}" Command="{Binding Add}" Margin="0,0,10,8"/>
            <Button Content="Importar Excel" Command="{Binding Import}" Margin="0,0,10,8"/>
            <Button Content="Programa de obra" Command="{Binding Program}" Margin="0,0,10,8"/>
            <Button Content="Avance real" Command="{Binding Progress}" Margin="0,0,10,8"/>
            <Button Content="Curva S y reportes" Command="{Binding Performance}" Margin="0,0,0,8"/>
          </WrapPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Catálogo y presupuesto" Style="{StaticResource SectionTitle}" />
            <Button Style="{StaticResource Help}" AutomationProperties.Name="Ayuda del presupuesto" Click="Help_Click">
              <Button.ToolTip>
                <TextBlock Text="Captura cantidades y precios unitarios sin IVA o importa el catálogo de Excel. Cada obra conserva sus propios precios. Al fijar el programa se protege este catálogo. El análisis detallado de precios se incorporará después." />
              </Button.ToolTip>
            </Button>
          </StackPanel>
          <TextBlock Text="Línea base fijada · catálogo protegido" Visibility="{Binding Frozen,Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
          <Grid>
            <DataGrid ItemsSource="{Binding Concepts}" AutomationProperties.Name="Conceptos de la obra">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Clave" Binding="{Binding Code}" Width="110" />
                <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="80" />
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity,StringFormat={}{0:N4}}" Width="115" />
                <DataGridTextColumn Header="P. unitario" Binding="{Binding UnitPrice,StringFormat={}{0:C2}}" Width="125" />
                <DataGridTextColumn Header="Importe" Binding="{Binding Amount,StringFormat={}{0:C2}}" Width="135" />
                <DataGridTemplateColumn Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Editar" Style="{StaticResource Quiet}" Padding="8,4" MinHeight="34" Command="{Binding DataContext.EditConcept,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Visibility="{Binding Empty,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,60,30,20" MaxWidth="440">
              <TextBlock Text="Construye el presupuesto de tu obra." FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Text="Agrega excavación, concreto u otros conceptos del catálogo que recibiste." Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <UniformGrid Grid.Row="3" Columns="3" Margin="0,20,0,0">
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20">
            <StackPanel>
              <TextBlock Text="Subtotal sin IVA" Foreground="{DynamicResource Muted}" />
              <TextBlock Text="{Binding Subtotal}" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20">
            <StackPanel>
              <TextBlock Text="{Binding TaxLabel}" Foreground="{DynamicResource Muted}" />
              <TextBlock Text="{Binding Tax}" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoft}" Padding="20">
            <StackPanel>
              <TextBlock Text="Total de la obra" />
              <TextBlock Text="{Binding Total}" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Mi perfil" Style="{StaticResource Heading}" />
            <Button Style="{StaticResource Help}" Click="Help_Click" AutomationProperties.Name="Ayuda del perfil">
              <Button.ToolTip>
                <TextBlock Text="Tus datos se guardan en este equipo. Este perfil no es una cuenta en línea ni una licencia. En esta vista previa se incluye en el respaldo local completo." />
              </Button.ToolTip>
            </Button>
          </StackPanel>
          <TextBlock Text="Administra tus datos personales y de contacto." Foreground="{DynamicResource Muted}" Margin="0,0,0,26" />
          <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
              <Border Background="{DynamicResource Tint}" Padding="26" CornerRadius="12,12,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="Perfil local" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                  <Border DockPanel.Dock="Left" Width="62" Height="62" CornerRadius="31" Background="{StaticResource Yellow}" Margin="0,0,20,0">
                    <TextBlock Text="{Binding Profile.Initials}" FontSize="25" Foreground="#30342B" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Profile.FullName}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Tu espacio en Trazal" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <StackPanel DataContext="{Binding Editor}" Margin="26">
                <Button Content="Mi cuenta · acceso y sesión" Command="{Binding DataContext.ShowAccount,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Right" Margin="0,0,0,20"/>
                <TextBlock Text="* Campos obligatorios" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,24" />
                <ItemsControl ItemsSource="{Binding Fields}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <vm:ResponsivePanel ColumnsLimit="2" Gap="22" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" Margin="0,8,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Volver a mis obras" Command="{Binding Cancel}" Margin="0,0,12,0" />
                  <Button Content="{Binding SaveLabel}" Command="{Binding Save}" Style="{StaticResource Primary}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid x:Name="Workspace">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DialogOpen}" Value="True">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
              <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
        <RowDefinition Height="34" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="28,0">
        <DockPanel LastChildFill="False">
          <Button DockPanel.Dock="Left" Style="{StaticResource Quiet}" Command="{Binding Home}" Padding="0" AutomationProperties.Name="Trazal, volver a mis obras">
            <StackPanel Orientation="Horizontal">
              <Path Data="M8 10h48v13H8z M25 27h14v29H25z M43 27h13v13H43z" Fill="{DynamicResource Ink}" Width="29" Height="30" Stretch="Uniform" Margin="0,0,10,0" />
              <TextBlock Text="trazal" FontSize="36" FontWeight="Bold" Margin="0,-5,0,0" />
            </StackPanel>
          </Button>
          <StackPanel x:Name="CompactBackup" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0">
            <Button Content="Respaldos" Command="{Binding ManageBackups}" Style="{StaticResource Quiet}" FontSize="14"/>
            <Button Content="Sincronización" Command="{Binding ShowSync}" Style="{StaticResource Quiet}" FontSize="14"/>
          </StackPanel>
          <Button DockPanel.Dock="Right" Command="{Binding ShowProfile}" Style="{StaticResource Quiet}" Padding="0" Margin="20,0,0,0" AutomationProperties.Name="Abrir mi perfil">
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="22" Width="44" Height="44">
              <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Border>
          </Button>
          <TextBlock x:Name="WelcomeText" DockPanel.Dock="Right" Text="{Binding Welcome}" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14" Foreground="{DynamicResource Muted}" />
          <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeName}" Width="125" MinHeight="40" VerticalAlignment="Center" AutomationProperties.Name="Tema de la interfaz" />
        </DockPanel>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="NavColumn" Width="218" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Tint}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,26">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
              <Button Content="Guardar respaldo" Command="{Binding Backup}" FontSize="14" Padding="10" ToolTip="Guarda una copia de las obras y el perfil en un archivo .trazal." />
              <Button Content="Restaurar respaldo" Command="{Binding RestoreBackup}" Style="{StaticResource Quiet}" FontSize="14" Margin="0,8,0,0" />
              <TextBlock Text="VISTA PREVIA · 0.6" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,18,0,0" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="ESPACIO DE TRABAJO" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,20" />
              <Button Content="Mis obras" Command="{Binding Home}" Style="{StaticResource NavigationItem}" Tag="{Binding IsWorksSection}" />
              <Button Content="Mi perfil" Command="{Binding ShowProfile}" Style="{StaticResource NavigationItem}" Tag="{Binding IsProfileSection}" Margin="0,8,0,0" />
              <Button Content="Sincronización" Command="{Binding ShowSync}" Style="{StaticResource NavigationItem}" Tag="{Binding IsSyncSection}" Margin="0,8,0,0" />
              <Button Content="Mi cuenta" Command="{Binding ShowAccount}" Style="{StaticResource NavigationItem}" Tag="{Binding IsAccountSection}" Margin="0,8,0,0" />
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="8,28,8,0" Padding="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="DENTRO DE CADA OBRA" FontSize="11" Foreground="{DynamicResource Muted}" />
                  <TextBlock Text="Programa, avances, gastos y reportes" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,17,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding Page}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="Guardado local · Sin conexión" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="20,0,0,0" />
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding Status}" />
        </DockPanel>
      </Border>
    </Grid>
    <Grid x:Name="ModalLayer" Background="#880F170D" Visibility="{Binding DialogOpen,Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
      <Border DataContext="{Binding Dialog}" Style="{StaticResource Card}" Width="600" Margin="24" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" MaxHeight="{Binding ActualHeight,ElementName=ModalLayer}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource Quiet}" Command="{Binding Cancel}" Padding="6,0" FontSize="28" MinHeight="32" AutomationProperties.Name="Cerrar formulario" />
              <TextBlock Text="TRAZAL / MI OBRA" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
              <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
              <Button Style="{StaticResource Help}" ToolTip="{Binding Help}" Click="Help_Click" AutomationProperties.Name="Ayuda del formulario" />
            </StackPanel>
            <TextBlock Text="* Campos obligatorios" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,20" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,8,0" />
          </ScrollViewer>
          <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="14" Margin="0,5,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
              <Button Content="Cancelar" Command="{Binding Cancel}" Margin="0,0,12,0" />
              <Button Content="{Binding SaveLabel}" Command="{Binding Save}" Style="{StaticResource Primary}" MinWidth="120" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
